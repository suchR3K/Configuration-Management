server {
    listen {{ nginx_port }};
    server_name {{ nginx_server_name }};
    root {{ app_root }}/current;
    index index.html;
    server_tokens off;
    access_log /var/log/nginx/ansible-lab-portal.access.log;
    error_log /var/log/nginx/ansible-lab-portal.error.log;
    add_header X-Content-Type-Options nosniff always;
    location / { try_files $uri $uri/ =404; }
    location = /healthz { try_files /index.html =503; }
    location ~ /\. { deny all; }
}
